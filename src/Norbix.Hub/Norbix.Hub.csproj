<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Norbix.Hub</PackageId>
    <Description>Official Norbix Hub SDK for .NET. Includes the core client runtime + Hub DTOs and generated Hub modules.</Description>
    <PackageTags>norbix;sdk;hub;schemas;integrations;billing;notifications</PackageTags>
    <RootNamespace>Norbix.Sdk</RootNamespace>
    <AssemblyName>Norbix.Hub</AssemblyName>
  </PropertyGroup>

  <!--
    Norbix.Contracts and Norbix.Hub.Types are not published on their own
    (IsPackable=false). PrivateAssets=all keeps them out of the nuspec
    dependencies, and IncludeBundledProjectReferences packs their DLLs into
    this package's lib folder instead. Without this the package depended on
    Norbix.Contracts / Norbix.Hub.Types packages that do not exist (NU1101).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Norbix.Contracts\Norbix.Contracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Norbix.Hub.Types\Norbix.Hub.Types.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeBundledProjectReferences</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeBundledProjectReferences" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Share the same runtime sources as Norbix.Api (no extra package). -->
    <Compile Include="..\Norbix.Sdk\**\*.cs"
             Exclude="..\Norbix.Sdk\bin\**\*;..\Norbix.Sdk\obj\**\*;..\Norbix.Sdk\HealthChecks\**\*;..\Norbix.Sdk\NorbixClient.Convenience.cs"
             LinkBase="SharedSdk" />
  </ItemGroup>

  <!-- The source generator runs in this project's own build only and is not
       packed; see the note in Norbix.Sdk.csproj. -->
  <ItemGroup>
    <ProjectReference
      Include="..\Norbix.Sdk.Generators\Norbix.Sdk.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>

