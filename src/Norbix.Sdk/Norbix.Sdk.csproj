<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The main client package. Bundles:
      · the hand-written transport / auth / login / options code
      · the Norbix.Contracts + Norbix.Sdk.Types assemblies (in lib/)
      · the modules generated by Norbix.Sdk.Generators at build time, compiled
        into Norbix.Api.dll. The generator itself is NOT shipped: run in a
        consumer's compilation it re-generated the modules against the
        internal INorbixTransport and the consumer build failed (CS0122).
  -->

  <PropertyGroup>
    <PackageId>Norbix.Api</PackageId>
    <Description>Official Norbix API SDK for .NET. Includes the core client runtime + API DTOs and generated API modules.</Description>
    <PackageTags>norbix;sdk;api;baas;backend;database;membership;ai</PackageTags>
    <RootNamespace>Norbix.Sdk</RootNamespace>
    <AssemblyName>Norbix.Api</AssemblyName>
  </PropertyGroup>

  <!--
    Norbix.Contracts and Norbix.Sdk.Types are not published on their own
    (IsPackable=false). PrivateAssets=all keeps them out of the nuspec
    dependencies, and IncludeBundledProjectReferences packs their DLLs into
    this package's lib folder instead. Without this the package depended on
    Norbix.Contracts / Norbix.Api.Types packages that do not exist (NU1101).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Norbix.Contracts\Norbix.Contracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Norbix.Sdk.Types\Norbix.Sdk.Types.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeBundledProjectReferences</TargetsForTfmSpecificBuildOutput>
    <!-- Packing with NoBuild (CI pack dry-run): resolve the referenced outputs without building
         them (NETSDK1085 otherwise). -->
    <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
  </PropertyGroup>

  <Target Name="IncludeBundledProjectReferences" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

  <!--
    The source generator runs in this project's own build only.
    ReferenceOutputAssembly=false keeps its DLL out of the runtime closure,
    and it is not packed (see the note at the top of this file).
  -->
  <ItemGroup>
    <ProjectReference
      Include="..\Norbix.Sdk.Generators\Norbix.Sdk.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
