<Project>

  <!--
    Centralized package management. All <PackageReference> elements across
    the solution use the versions pinned here. Adding a new dep:
      1. Add a <PackageVersion .../> entry below.
      2. Reference it from the relevant .csproj as <PackageReference Include="..." />
         (no Version attribute).
  -->

  <ItemGroup>
    <!-- Source generator authoring. The generator ships inside Norbix.Api and
         Norbix.Hub as an analyzer, so Microsoft.CodeAnalysis.CSharp must not be
         newer than the compiler in the lowest supported SDK (10.0.100 = Roslyn
         5.0). Microsoft.CodeAnalysis.Analyzers only runs in our own build. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" />

    <!-- Test stack: NUnit + Verify + AwesomeAssertions (drop-in for FluentAssertions) -->
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Verify.NUnit" Version="33.1.1" />

    <!-- ASP.NET / DI integration helper packages used by Norbix.Sdk's optional
         AddNorbix(...) helpers. We don't take a hard runtime dep on the full
         hosting stack — only the small abstractions packages. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />

    <!-- Source-link for symbol packages -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />

  </ItemGroup>

</Project>
